#: robot/main.cpp:62 server/main.cpp:352
#, c-format
msgid ""
"Usage: %s [option ...]\n"
"Valid options are:\n"
msgstr ""
"Użycie: %s [opcja ...]\n"
"Poprawnymi opcjami są:\n"

#: robot/main.cpp:63 server/main.cpp:353
#, c-format
msgid "  -h, --help\t\tPrint a summary of the options\n"
msgstr "  -h, --help\t\tWyświetla zestawienie opcji\n"

#: robot/main.cpp:64
#, c-format
msgid "  -n, --name NAME\tUse NAME as name\n"
msgstr "  -n, --name NAZWA\tUżywanie NAZWY jako nazwa\n"

#: robot/main.cpp:65
#, c-format
msgid "  -p, --port PORT\tConnect to server port PORT\n"
msgstr "  -p, --port PORT\tPołączenie z serwerem z portem nr. PORT\n"

#: robot/main.cpp:66
#, c-format
msgid "  -s, --server HOST\tConnect to the server at HOST\n"
msgstr "  -s, --server KOMPUTER\tPołączenie z serwerem KOMPUTER\n"

#: robot/main.cpp:67 server/main.cpp:356
#, c-format
msgid "  -v, --version\t\tPrint the version number\n"
msgstr "  -v, --version\t\tWyświetla numer wersji\n"

#: robot/main.cpp:68
#, c-format
msgid "  -c, --connected\t\tThe robot is already connected\n"
msgstr "  -c, --connected\t\tRobot jest już połączony\n"

#: robot/main.cpp:69
#, c-format
msgid "  -q, --quiet\t\tdont show messages\n"
msgstr "  -q, --quiet\t\twyłącza wyśwetlanie komunikatów\n"

