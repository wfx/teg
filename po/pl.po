#: robot/ai_msg.cpp:38
#, c-format
msgid "Hi %s"
msgstr "Cześć %s"

#: robot/ai_msg.cpp:39
#, c-format
msgid "Good luck %s"
msgstr "Powodzenia %s"

#: robot/ai_msg.cpp:40
#, c-format
msgid "How are you %s ?"
msgstr "Jak się miewasz %s ?"

#: robot/ai_msg.cpp:41
#, c-format
msgid "Welcome back %s!"
msgstr "Witaj z powrotem %s!"

#: robot/ai_msg.cpp:42
#, c-format
msgid "%s, I'll be the winner"
msgstr "%s, wygram tą rozgrywkę"

#: robot/ai_msg.cpp:43
#, c-format
msgid "Hey %s!"
msgstr "Hej %s!"

#: robot/ai_msg.cpp:50
#, c-format
msgid "Goodbye %s"
msgstr "Żegnaj %s"

#: robot/ai_msg.cpp:51
#, c-format
msgid "%s, you need to improve you game"
msgstr "%s, musisz poprawić swoją grę"

#: robot/ai_msg.cpp:52
#, c-format
msgid "%s, You really dont know how to play!"
msgstr "%s, ty naprawdę nie wiesz jak grać!"

#: robot/ai_msg.cpp:53
#, c-format
msgid "%s Better luck for the next time"
msgstr "%s, więcej szczęścia następnym razem"

#: robot/ai_msg.cpp:54
#, c-format
msgid "%s, try to improve your game"
msgstr "%s, spróbuj poprawić sposób swojej gry"

#: robot/ai_msg.cpp:59
#, c-format
msgid "%s, Do you have a sister ?"
msgstr "%s, masz siostrę ?"

#: robot/ai_msg.cpp:60
msgid "I love this game"
msgstr "Kocham tą grę"

#: robot/ai_msg.cpp:61
#, c-format
msgid "%s, I cant believe it!"
msgstr "%s, Nie wierzę!"

#: robot/ai_msg.cpp:62
#, c-format
msgid "%s, Do you have Lewinsky's phone ?"
msgstr "%s, Masz numer do Moniki Lewinski ?"

#: robot/ai_msg.cpp:63
msgid "Does anyone speak Speranto ?"
msgstr "Czy ktoś tu rozmawia w Esperanto ?"

#: robot/ai_msg.cpp:64
#, c-format
msgid "%s, You play very well"
msgstr "%s, grasz bardzo dobrze"

#: robot/ai_msg.cpp:65
msgid "Thanks"
msgstr "Dzięki"

#: robot/ai_msg.cpp:66
msgid "mmm..."
msgstr "mmm..."

#: robot/ai_msg.cpp:67
#, c-format
msgid "%s, Are you a robot ?"
msgstr "%s, jesteś robotem ?"

#: robot/ai_msg.cpp:68
msgid "Geronimoooooo"
msgstr "Geronimoooooo"

#: robot/ai_msg.cpp:69
msgid "I'm a bit tired"
msgstr "Chyba muszę się przespać"

#: robot/ai_msg.cpp:70
msgid "I'm hungry"
msgstr "Muszę coś zjeść"

#: robot/ai_msg.cpp:71
msgid "Who wants an Empanada ?"
msgstr "Kto chce Empanada ?"

#: robot/ai_msg.cpp:72
msgid "I like whistling"
msgstr "Lubię gwizdać"

#: robot/ai_msg.cpp:73
msgid "What is a good strategy to win this game?"
msgstr "Jaka jest najlepsza strategia by wygrać w tą grę?"

#: robot/ai_msg.cpp:74
#, c-format
msgid "%s, Were you here last night ?"
msgstr "%s, nie było się wczorajszej nocy ..."

#: robot/ai_msg.cpp:75
msgid "nod"
msgstr "niet"

#: robot/ai_msg.cpp:76
msgid "What?"
msgstr "Co?"

#: robot/ai_msg.cpp:77
msgid ":-)"
msgstr ":-)"

#: robot/ai_msg.cpp:78
#, c-format
msgid "%s, Do you think so?"
msgstr "%s, Tak myślisz?"

#: robot/ai_msg.cpp:79
#, c-format
msgid "%s, What can I say ?"
msgstr "%s, no i co mogę powiedzieć ?"

#: robot/ai_msg.cpp:80
#, c-format
msgid "%s, Do you think I'm ugly ?"
msgstr "%s, myślisz że jestem strasznie wyglądam ?"

#: robot/ai_msg.cpp:81
#, c-format
msgid "%s, Do you think I'm pretty ?"
msgstr "%s, myślisz że łądnie wyglądam ?"

#: robot/ai_msg.cpp:82
#, c-format
msgid "%s, Are you pretty ?"
msgstr "%s, ładnie wyglądasz ?"

#: robot/ai_msg.cpp:83
#, c-format
msgid "%s, Where do you live ?"
msgstr "%s, gdzie mieszkasz ?"

#: robot/ai_msg.cpp:84
#, c-format
msgid "%s, miauuuuuuuuu"
msgstr "%s, miauuuuuuuuu"

#: robot/ai_msg.cpp:95
#, c-format
msgid "%s, I dont agree"
msgstr "%s, nie zgadzam się"

#: robot/ai_msg.cpp:96
#, c-format
msgid "%s, Are you sure what you are saying?"
msgstr "%s, na pewno wiesz co mówisz?"

#: robot/ai_msg.cpp:97
#, c-format
msgid "%s, What are you saying"
msgstr "%s, co ty mówisz"

#: robot/ai_msg.cpp:98
#, c-format
msgid "%s, I dont understand you"
msgstr "%s, nie rozumiem cię"

#: robot/ai_msg.cpp:99
#, c-format
msgid "%s, funny"
msgstr "%s, zabawne"

#: robot/ai_msg.cpp:100
#, c-format
msgid "%s, What?"
msgstr "%s, Co?"

#: robot/ai_msg.cpp:101
#, c-format
msgid "%s, sure"
msgstr "%s, jasne"

#: robot/ai_msg.cpp:102
#, c-format
msgid "%s, Are you talking to me?"
msgstr "%s, mówisz do mnie?"

#: robot/ai_msg.cpp:103 robot/ai_msg.cpp:104
#, c-format
msgid "%s, you make me laugh"
msgstr "%s, rozśmieszasz mnie"

#: robot/ai_msg.cpp:105
#, c-format
msgid "%s, I dont think so"
msgstr "%s, nie sądzę"

#: robot/ai_msg.cpp:106
#, c-format
msgid "No %s, I dont believe that"
msgstr "Nie %s, nie wierzę w to"

#: robot/ai_msg.cpp:107
#, c-format
msgid "Yes, why not ? %s, but are you sure ?"
msgstr "Tak, czemu nie? %s, ale na pewno ?"

#: robot/ai_msg.cpp:108
#, c-format
msgid "Tomorrow, not today. %s dont get me wrong"
msgstr "Jutro, nie dzisiaj. %s tylko nie zrozum mnie źle"

#: robot/ai_msg.cpp:114
msgid "Scrapheap Sheriff"
msgstr ""

#: robot/ai_msg.cpp:115
