"Használat: %s [paraméter ...]\n"
"Érvényes paraméterek:\n"

#: robot/main.cpp:63 server/main.cpp:353
#, c-format
msgid "  -h, --help\t\tPrint a summary of the options\n"
msgstr "  -h, --help\t\tKiír egy összefoglalót a paraméterekről\n"

#: robot/main.cpp:64
#, c-format
msgid "  -n, --name NAME\tUse NAME as name\n"
msgstr "  -n, --name NÉV\tNÉV lesz a név\n"

#: robot/main.cpp:65
#, c-format
msgid "  -p, --port PORT\tConnect to server port PORT\n"
msgstr "  -p, --port PORT\tKapcsolódása a szerver PORT portjára\n"

#: robot/main.cpp:66
#, c-format
msgid "  -s, --server HOST\tConnect to the server at HOST\n"
msgstr "  -s, --server HOSZTNÉV\tKapcsolódás a HOSZTNÉV szerverre\n"

#: robot/main.cpp:67 server/main.cpp:356
#, c-format
msgid "  -v, --version\t\tPrint the version number\n"
msgstr "  -v, --version\t\tKiírja a verziószámot\n"

#: robot/main.cpp:68
#, c-format
msgid "  -c, --connected\t\tThe robot is already connected\n"
msgstr "  -c, --connected\t\tA robot már felkapcsolódott\n"

#: robot/main.cpp:69
#, c-format
msgid "  -q, --quiet\t\tdont show messages\n"
msgstr "  -q, --quiet\t\tNem ír ki üzeneteket\n"

