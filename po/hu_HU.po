#: robot/ai_msg.cpp:38
#, c-format
msgid "Hi %s"
msgstr "Hello %s"

#: robot/ai_msg.cpp:39
#, c-format
msgid "Good luck %s"
msgstr "Sok szerencsét %s"

#: robot/ai_msg.cpp:40
#, c-format
msgid "How are you %s ?"
msgstr "Hogy vagy %s?"

#: robot/ai_msg.cpp:41
#, c-format
msgid "Welcome back %s!"
msgstr "Isten hozott újra nállunk %s!"

#: robot/ai_msg.cpp:42
#, c-format
msgid "%s, I'll be the winner"
msgstr "%s, én leszek a győztes"

#: robot/ai_msg.cpp:43
#, c-format
msgid "Hey %s!"
msgstr "Hé, %s!"

#: robot/ai_msg.cpp:50
#, c-format
msgid "Goodbye %s"
msgstr "Szervusz %s"

#: robot/ai_msg.cpp:51
#, c-format
msgid "%s, you need to improve you game"
msgstr "%s, javítanod kell a stratégiádon"

#: robot/ai_msg.cpp:52
#, c-format
msgid "%s, You really dont know how to play!"
msgstr "%s, te tényleg nem tudod hogyan kell játszani!"

#: robot/ai_msg.cpp:53
#, c-format
msgid "%s Better luck for the next time"
msgstr "%s, sok szerencsét legközelebb"

#: robot/ai_msg.cpp:54
#, c-format
msgid "%s, try to improve your game"
msgstr "%s, próbálj javítani a taktikádon"

#: robot/ai_msg.cpp:59
#, c-format
msgid "%s, Do you have a sister ?"
msgstr "%s, van lány testvéred?"

#: robot/ai_msg.cpp:60
msgid "I love this game"
msgstr "Szeretem ezt a játékot"

#: robot/ai_msg.cpp:61
#, c-format
msgid "%s, I cant believe it!"
msgstr "%s, ezt nem hiszem el!"

#: robot/ai_msg.cpp:62
#, c-format
msgid "%s, Do you have Lewinsky's phone ?"
msgstr "%s, hogy ityeg a fityeg?"

#: robot/ai_msg.cpp:63
msgid "Does anyone speak Speranto ?"
msgstr "Beszél valaki Eszperentó nyelven?"

#: robot/ai_msg.cpp:64
#, c-format
msgid "%s, You play very well"
msgstr "%s, nagyon jól játszol"

#: robot/ai_msg.cpp:65
msgid "Thanks"
msgstr "Kössz"

#: robot/ai_msg.cpp:66
msgid "mmm..."
msgstr "mmm..."

#: robot/ai_msg.cpp:67
#, c-format
msgid "%s, Are you a robot ?"
msgstr "%s, te robot vagy?"

#: robot/ai_msg.cpp:68
msgid "Geronimoooooo"
msgstr "Geronimoooooo"

#: robot/ai_msg.cpp:69
msgid "I'm a bit tired"
msgstr "Egy kicsit fáradt vagyok"

#: robot/ai_msg.cpp:70
msgid "I'm hungry"
msgstr "Éhes vagyok"

#: robot/ai_msg.cpp:71
msgid "Who wants an Empanada ?"
msgstr "Ki kér egy sütit?"

#: robot/ai_msg.cpp:72
msgid "I like whistling"
msgstr "Tetszenek nekem a kívánságlisták"

#: robot/ai_msg.cpp:73
msgid "What is a good strategy to win this game?"
msgstr "Mi a jó nyerő stratégia ebben a játékban?"

#: robot/ai_msg.cpp:74
#, c-format
msgid "%s, Were you here last night ?"
msgstr "%s, te itt voltál tegnap éjjel?"

#: robot/ai_msg.cpp:75
msgid "nod"
msgstr "ok"

#: robot/ai_msg.cpp:76
msgid "What?"
msgstr "Mi?"

#: robot/ai_msg.cpp:77
msgid ":-)"
msgstr ":-)"

#: robot/ai_msg.cpp:78
#, c-format
msgid "%s, Do you think so?"
msgstr "Szerinted is %s?"

#: robot/ai_msg.cpp:79
#, c-format
msgid "%s, What can I say ?"
msgstr "Mit mondhatnék %s?"

#: robot/ai_msg.cpp:80
#, c-format
msgid "%s, Do you think I'm ugly ?"
msgstr "%s, szerinted csúnya vagyok?"

#: robot/ai_msg.cpp:81
#, c-format
msgid "%s, Do you think I'm pretty ?"
msgstr "%s, szerinted csinos vagyok?"

#: robot/ai_msg.cpp:82
#, c-format
msgid "%s, Are you pretty ?"
msgstr "%s, te csinos vagy?"

#: robot/ai_msg.cpp:83
#, c-format
msgid "%s, Where do you live ?"
msgstr "%s, hol laksz?"

#: robot/ai_msg.cpp:84
#, c-format
msgid "%s, miauuuuuuuuu"
msgstr "%s, miauuuuuuuuu"

#: robot/ai_msg.cpp:95
#, c-format
msgid "%s, I dont agree"
msgstr "%s, nem értek egyet"

#: robot/ai_msg.cpp:96
#, c-format
msgid "%s, Are you sure what you are saying?"
msgstr "%s, biztos vagy benne?"

#: robot/ai_msg.cpp:97
#, c-format
msgid "%s, What are you saying"
msgstr "%s, mit mondtál?"

#: robot/ai_msg.cpp:98
#, c-format
msgid "%s, I dont understand you"
msgstr "%s, nem értelek"

#: robot/ai_msg.cpp:99
#, c-format
msgid "%s, funny"
msgstr "%s, vicces"

#: robot/ai_msg.cpp:100
#, c-format
msgid "%s, What?"
msgstr "%s, mi?"

#: robot/ai_msg.cpp:101
#, c-format
msgid "%s, sure"
msgstr "%s, persze"

#: robot/ai_msg.cpp:102
#, c-format
msgid "%s, Are you talking to me?"
msgstr "%s, hozzám beszélsz?"

#: robot/ai_msg.cpp:103 robot/ai_msg.cpp:104
#, c-format
msgid "%s, you make me laugh"
msgstr "%s, nevetnem kell tőled"

#: robot/ai_msg.cpp:105
#, c-format
msgid "%s, I dont think so"
msgstr "%s, nem hiszem"

#: robot/ai_msg.cpp:106
#, c-format
msgid "No %s, I dont believe that"
msgstr "Nem %s, azt nem hiszem"

#: robot/ai_msg.cpp:107
#, c-format
msgid "Yes, why not ? %s, but are you sure ?"
msgstr "Igen, miért ne? De biztos vagy benne %s?"

#: robot/ai_msg.cpp:108
#, c-format
msgid "Tomorrow, not today. %s dont get me wrong"
msgstr "Holnap, nem ma. Ne húzz fel %s"

#: robot/ai_msg.cpp:114
msgid "Scrapheap Sheriff"
msgstr ""

