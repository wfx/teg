#: robot/ai_msg.cpp:38
#, c-format
msgid "Hi %s"
msgstr "Hi %s"

#: robot/ai_msg.cpp:39
#, c-format
msgid "Good luck %s"
msgstr "Viel Glück %s"

#: robot/ai_msg.cpp:40
#, c-format
msgid "How are you %s ?"
msgstr "Wie geht's dir %s ?"

#: robot/ai_msg.cpp:41
#, c-format
msgid "Welcome back %s!"
msgstr "Willkommen zurück %s!"

#: robot/ai_msg.cpp:42
#, c-format
msgid "%s, I'll be the winner"
msgstr "%s, Ich werde gewinnen"

#: robot/ai_msg.cpp:43
#, c-format
msgid "Hey %s!"
msgstr "Hey %s!"

#: robot/ai_msg.cpp:50
#, c-format
msgid "Goodbye %s"
msgstr "Ciao %s"

#: robot/ai_msg.cpp:51
#, c-format
msgid "%s, you need to improve you game"
msgstr "%s, du solltest mehr üben"

#: robot/ai_msg.cpp:52
#, c-format
msgid "%s, You really dont know how to play!"
msgstr "%s, du weißt wirklich nicht wie man spielt!"

#: robot/ai_msg.cpp:53
#, c-format
msgid "%s Better luck for the next time"
msgstr "%s Vielleicht nächstes Mal"

#: robot/ai_msg.cpp:54
#, c-format
msgid "%s, try to improve your game"
msgstr "%s, du solltest besser spielen"

#: robot/ai_msg.cpp:59
#, c-format
msgid "%s, Do you have a sister ?"
msgstr "%s, hast du 'ne Schwester?"

#: robot/ai_msg.cpp:60
msgid "I love this game"
msgstr "Ich liebe dieses Spiel"

#: robot/ai_msg.cpp:61
#, c-format
msgid "%s, I cant believe it!"
msgstr "%s, ich kann es nicht glauben!"

#: robot/ai_msg.cpp:62
#, c-format
msgid "%s, Do you have Lewinsky's phone ?"
msgstr "%s, hast du was an den Ohren?"

#: robot/ai_msg.cpp:63
msgid "Does anyone speak Speranto ?"
msgstr "Spricht irgendwer Deutsch?"

#: robot/ai_msg.cpp:64
#, c-format
msgid "%s, You play very well"
msgstr "%s, du spielst gar nicht so schlecht"

#: robot/ai_msg.cpp:65
msgid "Thanks"
msgstr "Danke"

#: robot/ai_msg.cpp:66
msgid "mmm..."
msgstr "hmmm...."

#: robot/ai_msg.cpp:67
#, c-format
msgid "%s, Are you a robot ?"
msgstr "%s, bist du ein Roboter?"

#: robot/ai_msg.cpp:68
msgid "Geronimoooooo"
msgstr "Attaaaaackeeee"

#: robot/ai_msg.cpp:69
msgid "I'm a bit tired"
msgstr "Ich bin müde"

#: robot/ai_msg.cpp:70
msgid "I'm hungry"
msgstr "Ich bin hungrig"

#: robot/ai_msg.cpp:71
msgid "Who wants an Empanada ?"
msgstr "Wer will ein Empanada?"

#: robot/ai_msg.cpp:72
msgid "I like whistling"
msgstr "Ich mag pfeifen"

#: robot/ai_msg.cpp:73
msgid "What is a good strategy to win this game?"
msgstr "Gibt's eine gute Strategie um dieses Spiel zu gewinnen?"

#: robot/ai_msg.cpp:74
#, c-format
msgid "%s, Were you here last night ?"
msgstr "%s, warst du nicht schon letzte Nacht hier?"

#: robot/ai_msg.cpp:75
msgid "nod"
msgstr "jaja"

#: robot/ai_msg.cpp:76
msgid "What?"
msgstr "Hääh?"

#: robot/ai_msg.cpp:77
msgid ":-)"
msgstr ":-)"

#: robot/ai_msg.cpp:78
#, c-format
msgid "%s, Do you think so?"
msgstr "%s, glaubst doch selber nicht?"

#: robot/ai_msg.cpp:79
#, c-format
msgid "%s, What can I say ?"
msgstr "%s, was soll ich dazu sagen?"

#: robot/ai_msg.cpp:80
#, c-format
msgid "%s, Do you think I'm ugly ?"
msgstr "%s, behauptest du etwa ich wäre häßlich?"

#: robot/ai_msg.cpp:81
#, c-format
msgid "%s, Do you think I'm pretty ?"
msgstr "%s, glaubst du ich wäre zu gut für dich?"

#: robot/ai_msg.cpp:82
#, c-format
msgid "%s, Are you pretty ?"
msgstr "%s, wie siehst du aus?"

#: robot/ai_msg.cpp:83
#, c-format
msgid "%s, Where do you live ?"
msgstr "%s, wo lebst du?"

#: robot/ai_msg.cpp:84
#, c-format
msgid "%s, miauuuuuuuuu"
msgstr "%s, miauuuuuu"

#: robot/ai_msg.cpp:95
#, c-format
msgid "%s, I dont agree"
msgstr "%s, da liegst fett daneben"

#: robot/ai_msg.cpp:96
#, c-format
msgid "%s, Are you sure what you are saying?"
msgstr "%s, kann's sein dass du Scheiß daher laberst?"

#: robot/ai_msg.cpp:97
#, c-format
msgid "%s, What are you saying"
msgstr "%s, WIE BITTE?"

#: robot/ai_msg.cpp:98
#, c-format
msgid "%s, I dont understand you"
msgstr "%s, kapier ich nicht"

#: robot/ai_msg.cpp:99
#, c-format
msgid "%s, funny"
msgstr "%s, sehr lustig.."

#: robot/ai_msg.cpp:100
#, c-format
msgid "%s, What?"
msgstr "%s, was?"

#: robot/ai_msg.cpp:101
#, c-format
msgid "%s, sure"
msgstr "%s, schon klar"

#: robot/ai_msg.cpp:102
#, c-format
msgid "%s, Are you talking to me?"
msgstr "%s, redest du mit mir?"

#: robot/ai_msg.cpp:103 robot/ai_msg.cpp:104
#, c-format
msgid "%s, you make me laugh"
msgstr "%s, sehr lustig"

#: robot/ai_msg.cpp:105
#, c-format
msgid "%s, I dont think so"
msgstr "%s, glaub ich kaum?"

#: robot/ai_msg.cpp:106
#, c-format
msgid "No %s, I dont believe that"
msgstr "Nein %s, ich kann es nicht glauben!"

#: robot/ai_msg.cpp:107
#, c-format
msgid "Yes, why not ? %s, but are you sure ?"
msgstr "Ja, warum nicht? Aber %s bist du dir auch ganz sicher?"

#: robot/ai_msg.cpp:108
#, c-format
msgid "Tomorrow, not today. %s dont get me wrong"
msgstr "Morgen, nicht heute. Versteh mich nicht falsch %s"

