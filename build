#!/bin/bash

# Configure and build TEG out-of-source with Meson/Ninja.
#
# Usage: ./build [BUILD_DIR]
#
# BUILD_DIR defaults to "bd". The build never touches the source tree; the
# install prefix is placed inside the build directory (BUILD_DIR/DD).

set -euo pipefail

SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
BUILD_DIR="${SCRIPT_DIR}/${1:-bd}"

if ! command -v meson >/dev/null 2>&1; then
	echo "error: meson is not installed (e.g. 'pip install meson ninja')." >&2
	exit 1
fi

if [ -f "${BUILD_DIR}/meson-private/coredata.dat" ]; then
	meson setup --wipe "${BUILD_DIR}" \
		--prefix "${BUILD_DIR}/DD" \
		-Dwerror=true
else
	# A leftover, non-Meson build directory (e.g. from the old Autotools
	# setup) would confuse Meson, so start from a clean slate.
	rm -rf "${BUILD_DIR}"
	meson setup "${BUILD_DIR}" \
		--prefix "${BUILD_DIR}/DD" \
		-Dwerror=true
fi

meson compile -C "${BUILD_DIR}"
meson test -C "${BUILD_DIR}" -v
